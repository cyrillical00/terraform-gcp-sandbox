# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored — never commit it

project_id  = "your-gcp-project-id"
region      = "us-central1"
zone        = "us-central1-a"
environment = "sandbox"

# REPLACE_WITH_YOUR_PUBLIC_IP: your own address as a /32, or the IAP range
# 35.235.240.0/20 if you connect with `gcloud compute ssh --tunnel-through-iap`.
ssh_source_ranges = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]
